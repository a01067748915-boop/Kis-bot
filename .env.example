# 복사해서 .env 로 만들고 값 입력 (setup.sh 가 자동 복사). .env 는 절대 공유·커밋하지 마세요.

# ─── 한국투자증권 오픈API ───
KIS_ENV=mock                 # mock(모의투자) / real(실전)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=12345678-01      # 계좌번호 8자리-상품코드 2자리

# ─── 안전 ───
DRY_RUN=true                 # true면 주문 없이 알림만. 충분히 확인 후 false

# ─── 전략 ───
BUDGET_USD=950               # 봇이 쓸 총 금액(달러), 종목 수로 균등 배분
TARGETS=QQQM:NAS,SOXX:NAS    # 심볼:거래소(NAS/NYS/AMS)
K=0.5                        # 목표가 = 시가 + K × 전일 변동폭
MA_FILTER=5                  # 시가가 N일 이동평균 위일 때만 진입 (0=사용 안 함)
STOP_LOSS_PCT=2              # 종목별 손절(%)
DAILY_LOSS_LIMIT_PCT=3       # 예산 대비 일일 손실 한도(%)
MAX_CHASE_PCT=1              # 목표가보다 이만큼(%) 넘게 오르면 추격 매수 안 함
LIMIT_SLIP_PCT=0.3           # 지정가를 현재가보다 얼마나 유리하게 걸지(%)
FEE_PCT=0.25                 # 편도 수수료(%) — 본인 수수료율로

# ─── 시간 (뉴욕 현지시간) ───
ENTRY_START=09:35
ENTRY_END=15:00
EXIT_TIME=15:45
POLL_SEC=10
FILL_WAIT_SEC=12

# ─── 텔레그램 (비우면 알림 끔) ───
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=      # 명령 허용 사용자 ID(쉼표 구분). 단체방이면 꼭 입력, 개인 채팅이면 비워도 됨
