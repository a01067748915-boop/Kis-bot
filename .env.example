# 복사해서 .env 로 만들고 값 입력 (setup.sh 가 자동 복사). .env 는 절대 공유·커밋하지 마세요.

# ─── 한국투자증권 오픈API ───
KIS_ENV=mock                 # mock(모의투자) / real(실전)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=12345678-01      # 계좌번호 8자리-상품코드 2자리

# ─── 안전 ───
DRY_RUN=true                 # true면 주문 없이 알림만. 충분히 확인 후 false

# ─── 전략 ───
STRATEGY=breakout            # breakout=변동성 돌파 단타 / pullback=눌림목 매수(며칠 보유)
BUDGET_USD=950               # 봇이 쓸 총 금액(달러). breakout 은 종목 수로, pullback 은 SLOTS 로 나눔
TARGETS=QQQM:NAS,SOXX:NAS    # 심볼:거래소(NAS/NYS/AMS)
K=0.5                        # 목표가 = 시가 + K × 전일 변동폭
MA_FILTER=5                  # 시가가 N일 이동평균 위일 때만 진입 (0=사용 안 함)
STOP_LOSS_PCT=2              # 종목별 손절(%)
DAILY_LOSS_LIMIT_PCT=3       # 예산 대비 하루 손실 한도(%), 넘으면 전량 청산·당일 중단. 0=끔
MAX_CHASE_PCT=1              # 목표가보다 이만큼(%) 넘게 오르면 추격 매수 안 함
LIMIT_SLIP_PCT=0.3           # 지정가를 현재가보다 얼마나 유리하게 걸지(%)
FEE_PCT=0.25                 # 편도 수수료(%) — 본인 수수료율로

# ─── pullback 전용 ───
SLOTS=2                      # 예산을 몇 칸으로 나눌지(동시에 들고 있을 최대 종목 수)
RSI_MAX=10                   # 전날 RSI(2)가 이보다 낮으면 매수 후보
TREND_MA=200                 # 전날 종가가 이 이동평균 위인 종목만
EXIT_MA=5                    # 종가가 이 이동평균 위로 회복하면 다음 날 아침 매도
MAX_HOLD_DAYS=10             # 회복 못 해도 이 거래일 지나면 매도
PULLBACK_STOP_PCT=0          # 매수가 대비 손절(%), 0=끔 (백테스트에서 손절은 성과를 낮춤)

# ─── 시간 (뉴욕 현지시간) ───
ENTRY_START=09:35
ENTRY_END=15:00
EXIT_TIME=15:45              # EXIT_MODE=close 일 때 청산 시작 시각
EXIT_MODE=close              # close=당일 장 마감 전 청산 / next_open=들고 넘어가 다음 거래일 장 초반(ENTRY_START)에 매도
POLL_SEC=10
FILL_WAIT_SEC=12

# ─── Alpaca (분봉 백테스트 minute_backtest.py 전용, 주문에는 안 씀) ───
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# ─── SEC EDGAR (기본적 분석 analysis.py 전용, 무료·키 없음, 요청마다 연락처 필요) ───
SEC_USER_AGENT=              # 예: "Hong Gildong hong@example.com"

# ─── 텔레그램 (비우면 알림 끔) ───
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USERS=      # 명령 허용 사용자 ID(쉼표 구분). 단체방이면 꼭 입력, 개인 채팅이면 비워도 됨
