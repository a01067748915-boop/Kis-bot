# ── Gate.io API (출금 권한 OFF, IP 화이트리스트에 서버 IP 등록) ──
GATE_KEY=
GATE_SECRET=

# true = 모의(주문 안 나감) / false = 실거래
DRY_RUN=true

# ── 종목 (쉼표로 구분, 비우면 해당 시장 사용 안 함) ──
SPOT_SYMBOLS=BTC_USDT,ETH_USDT
FUTURES_SYMBOLS=BTC_USDT

# ── 전략 ──
INTERVAL=15m            # 1m 5m 15m 30m 1h 4h 1d
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_MAX_LONG=70         # RSI가 이 값 이상이면 매수 안 함(과열)
RSI_MIN_SHORT=30        # RSI가 이 값 이하면 숏 안 함(과매도)
REVERSE_ON_SIGNAL=false # true면 반대 신호 때 청산 후 바로 반대 방향 진입(수수료 2배)

# ── 자금/리스크 ──
ORDER_USDT=20           # 1회 진입 금액(선물은 증거금)
LEVERAGE=3              # 선물 레버리지 (코드에서 최대 10 제한)
ALLOW_SHORT=true
STOP_LOSS_PCT=3         # 가격 기준 손절 %
TAKE_PROFIT_PCT=6       # 가격 기준 익절 %
EXCHANGE_STOPS=true     # 선물: 거래소에 손절·익절 예약 주문도 걸기 (봇이 꺼져도 작동)
DAILY_LOSS_LIMIT_USDT=10  # 하루 손실이 이만큼 넘으면 신규 진입 중단

# ── 수수료 (모의·백테스트 계산용, 편도 %) ──
SPOT_FEE_PCT=0.1
FUT_FEE_PCT=0.05

LOOP_SEC=20             # 손절·익절 확인 간격(초)
REPORT_HOUR=9           # 매일 리포트 시각(서버 시간), -1이면 끔

# ── 가격·급등락 알림 (텔레그램 필요) ──
ALERT_SYMBOLS=BTC_USDT,ETH_USDT,SOL_USDT,XRP_USDT,TRX_USDT
ALERT_MOVE_1H_PCT=3     # 1시간 ±3% 움직이면 알림 (0=끔)
ALERT_MOVE_24H_PCT=8    # 24시간 ±8% 움직이면 알림 (0=끔)
ALERT_CHECK_SEC=300     # 급등락 확인 간격(초)
ALERT_COOLDOWN_MIN=120  # 같은 알림은 이 시간(분)에 한 번

# ── 텔레그램 수동 매매 (/buy /sell → /confirm) — 자동매매 모의 여부와 별개로 '실제' 주문 ──
MANUAL_TRADING=false
MANUAL_MAX_USDT=30      # 1회 최대 매수 금액

# ── 텔레그램 알림 (선택) ──
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
